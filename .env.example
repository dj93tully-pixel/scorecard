# golfcourseapi.com API key — used ONLY by server-side route handlers.
# Get a key at https://golfcourseapi.com — copy this file to .env.local and paste your key there.
# Must NOT be prefixed with NEXT_PUBLIC (the key must never reach the browser).
GOLF_COURSE_API_KEY=

# Supabase — the shared games database. These are browser-safe public values
# (anon/publishable key, protected by RLS), so the NEXT_PUBLIC_ prefix is fine.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
